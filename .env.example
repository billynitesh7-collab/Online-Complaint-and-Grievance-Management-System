# Server Configuration
PORT=5001
NODE_ENV=development

# Security & CORS / CSRF Allowed Origins (comma-separated, optional)
ALLOWED_ORIGINS=http://localhost:5001

# Database Configuration (PostgreSQL)
# Option A: Discrete Connection Parameters (Default Local Development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=online_grievance_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# Option B: Single Connection String (Used automatically on Render/Cloud if provided)
# DATABASE_URL=postgres://user:password@hostname:5432/online_grievance_db?sslmode=require

# Session Secret (Use a strong random 32+ character key in production)
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Admin Seed Account (for scripts/seedAdmin.js)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_secure_admin_password

